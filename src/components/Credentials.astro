---
import { assetUrl } from "../lib/media";
interface Certificate {
  credential: string;
  issuer: string;
  date: string;
  file: string;
  verification_url: string;
  preview?: string;
}
const { certificates } = Astro.props as { certificates: Certificate[] };
---

<div class="credentials certificate-browser">
  <h3 class="support-heading">
    Continued learning <span class="mono">CREDENTIALS</span>
  </h3>
  <div class="certificate-layout">
    <div class="certificate-list" aria-label="Choose a certificate">
      {certificates.map((c, i) => (
        <button
          type="button"
          data-certificate-index={i}
          aria-pressed={i === 0}
          aria-controls={`certificate-panel-${i}`}
        >
          <span class="eyebrow">
            {c.issuer} · {c.date}
          </span>
          <strong>{c.credential}</strong>
          <span class="certificate-indicator" aria-hidden="true">
            ↗
          </span>
        </button>
      ))}
    </div>
    <div class="certificate-stage media-gallery">
      {certificates.map((c, i) => {
        const preview =
          c.preview ||
          (/\.(png|jpe?g|webp|avif|gif)$/i.test(c.file) ? c.file : "");
        return (
          <figure
            class="certificate-panel"
            id={`certificate-panel-${i}`}
            hidden={i !== 0}
          >
            {preview ? (
              <a
                class="media-open certificate-image"
                href={assetUrl(preview)}
                data-caption={c.credential}
                aria-label={`Enlarge certificate: ${c.credential}`}
              >
                <img
                  src={assetUrl(preview)}
                  alt={`${c.credential} certificate`}
                  width="1200"
                  height="900"
                  loading="lazy"
                />
                <span class="mono">Enlarge certificate ↗</span>
              </a>
            ) : (
              <p class="certificate-missing">Certificate image coming soon.</p>
            )}
            <figcaption>
              <strong>{c.credential}</strong>
              <span>
                {c.issuer} · {c.date}
              </span>
              <div class="certificate-links">
                {c.verification_url && (
                  <a href={c.verification_url} target="_blank" rel="noreferrer">
                    Verify credential ↗
                  </a>
                )}
                {c.file && !/\.(png|jpe?g|webp|avif|gif)$/i.test(c.file) && (
                  <a href={assetUrl(c.file)} target="_blank" rel="noreferrer">
                    Original document ↗
                  </a>
                )}
              </div>
            </figcaption>
          </figure>
        );
      })}
      <div class="certificate-navigation">
        <button
          type="button"
          class="certificate-previous"
          aria-label="Previous certificate"
        >
          ←
        </button>
        <span class="mono certificate-count" aria-live="polite">
          01 / {String(certificates.length).padStart(2, "0")}
        </span>
        <button
          type="button"
          class="certificate-next"
          aria-label="Next certificate"
        >
          →
        </button>
      </div>
      <noscript>
        <p>
          {certificates.map((c) => (
            <a href={assetUrl(c.preview || c.file)}>{c.credential} ↗ </a>
          ))}
        </p>
      </noscript>
    </div>
  </div>
</div>
<style>
  .certificate-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.5fr);
    gap: 40px;
    align-items: start;
  }
  .certificate-list {
    display: grid;
    border-top: 1px solid var(--border);
  }
  .certificate-list button {
    position: relative;
    text-align: left;
    padding: 22px 38px 22px 16px;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .certificate-list button[aria-pressed="true"] {
    background: var(--surface-soft);
    color: var(--text);
    box-shadow: inset 2px 0 var(--text);
  }
  .certificate-list strong {
    display: block;
    margin-top: 9px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }
  .certificate-indicator {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
  }
  .certificate-stage.media-gallery {
    display: block;
    margin: 0;
    min-width: 0;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 12px;
    overflow: hidden;
  }
  .certificate-panel[hidden] {
    display: none;
  }
  .certificate-image {
    display: block;
    padding: 20px;
    background: var(--surface-soft);
  }
  .certificate-image img {
    display: block;
    width: 100%;
    height: clamp(200px, 28vw, 380px);
    object-fit: contain;
  }
  .certificate-image > span {
    display: block;
    text-align: right;
    margin-top: 14px;
    font-size: 10px;
    color: var(--muted);
  }
  .certificate-panel figcaption {
    display: grid;
    gap: 8px;
    padding: 20px 24px;
    color: var(--muted);
    font-size: 12px;
  }
  .certificate-panel figcaption strong {
    color: var(--text);
    font-weight: 500;
    font-size: 14px;
  }
  .certificate-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .certificate-navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding: 12px 20px;
  }
  .certificate-navigation button {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    width: 40px;
    height: 36px;
    border-radius: 6px;
    cursor: pointer;
  }
  .certificate-count {
    font-size: 10px;
    color: var(--muted);
  }
  .certificate-missing {
    padding: 40px 24px;
  }
  @media (max-width: 700px) {
    .certificate-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .certificate-list button {
      padding: 16px 38px 16px 14px;
    }
    .certificate-image {
      padding: 12px;
    }
    .certificate-image img {
      height: 240px;
    }
  }
</style>
